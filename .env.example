# Road Hawk runtime configuration
# Copy to .env for local overrides (not committed).

# standalone = local API + SQLite on one machine (default)
# server     = this host accepts remote dashboard/API clients
# client     = CLI/UI-only install that connects outward
ROAD_HAWK_MODE=standalone

# Require remote users to log in (set on fleet servers)
# ROAD_HAWK_AUTH_REQUIRED=1

# Bootstrap the first admin when the user table is empty (fleet server first boot)
# ROAD_HAWK_ADMIN_USER=admin
# ROAD_HAWK_ADMIN_PASSWORD=change-me

# API server bind (standalone server mode). Use 0.0.0.0 to accept LAN/remote clients.
ROAD_HAWK_API_HOST=0.0.0.0
ROAD_HAWK_API_PORT=8000

# Optional explicit API URL advertised in /api/health
# ROAD_HAWK_API_URL=http://192.168.1.50:8000

# SQLite data directory (portable installs, USB drive, per-device storage)
# ROAD_HAWK_DATA_DIR=/var/lib/road-hawk/data

# Comma-separated browser origins allowed to call the API (add your remote UI host)
# ROAD_HAWK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.10:3000